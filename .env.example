# PostgreSQL connection (see docker-compose.yml for local dev defaults)
DATABASE_URL="postgresql://sigec:sigec@localhost:5432/sigec_sm?schema=public"

# Session/JWT signing secret - generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-value"

# Chiffrement applicatif des champs sensibles (ex: DeathRecord.cause) -
# exactement 32 octets une fois decode en base64. Generer avec:
#   openssl rand -base64 32
# ATTENTION : changer cette cle rend illisibles les donnees deja chiffrees
# avec l'ancienne (voir docs/BACKUP.md pour la procedure de rotation).
ENCRYPTION_KEY="change-me-32-bytes-base64-encoded"

# Used to build absolute verification URLs on QR codes/documents (Phase 3)
APP_BASE_URL="http://localhost:3000"
