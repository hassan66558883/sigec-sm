# PostgreSQL connection (see docker-compose.yml for local dev defaults)
DATABASE_URL="postgresql://sigec:sigec@localhost:5432/sigec_sm?schema=public"

# Taille max du pool de connexions applicatif (src/lib/db.ts). Defaut : 25.
# A ajuster selon le budget de connexions reel du serveur Postgres cible
# (voir max_connections) et le nombre d'instances de l'app deployees.
# DATABASE_POOL_MAX=25

# Session/JWT signing secret - generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-value"

# Chiffrement applicatif des champs sensibles (ex: DeathRecord.cause) -
# exactement 32 octets une fois decode en base64. Generer avec:
#   openssl rand -base64 32
# ATTENTION : changer cette cle rend illisibles les donnees deja chiffrees
# avec l'ancienne (voir docs/BACKUP.md pour la procedure de rotation).
ENCRYPTION_KEY="change-me-32-bytes-base64-encoded"

# Used to build absolute verification URLs on QR codes/documents (Phase 3)
APP_BASE_URL="http://localhost:3000"

# Protects POST /api/cron/relances, /api/cron/webhook-retries et
# /api/cron/health-checks (echeancier de relance, retry des livraisons de
# webhook, verification periodique de sante des systemes connectes) - a
# appeler par un cron systeme externe, jamais par un agent connecte.
# Generer avec: openssl rand -base64 32
# Voir docs/DEPLOYMENT.md section 7 pour les entrees cron.
CRON_SECRET="change-me-to-a-long-random-value"

# Signature des jetons d'acces OAuth2 (client_credentials) emis par
# POST /api/v1/oauth/token (Integration & Interoperability Center, section
# 16) - distinct de SESSION_SECRET (domaine de confiance different :
# systemes externes authentifies par cle API/OAuth2, jamais des sessions
# agent). Generer avec: openssl rand -base64 32
OAUTH_TOKEN_SECRET="change-me-to-a-long-random-value"
