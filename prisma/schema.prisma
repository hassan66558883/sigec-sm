// SIGEC-SM — Systeme Integre de Gestion de l'Etat Civil et des Services
// Municipaux (Ville de N'Djamena)
//
// PHASE 1 — FONDATION
// Authentification, utilisateurs, roles/permissions (RBAC), structure
// territoriale (villes > arrondissements > quartiers > secteurs), isolation
// des donnees par arrondissement, audit log, parametres systeme.
//
// Les phases suivantes (etat civil, portail citoyen, foncier, finances,
// services municipaux, analytics) ajouteront leurs propres modeles sans
// modifier la structure ci-dessous, hormis l'ajout de relations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Utilisateurs & RBAC -------------------------------------------------

// La Ville de N'Djamena est administree par UNE Mairie Centrale ; les 10
// arrondissements sont ses subdivisions territoriales, pas des mairies
// independantes. organizationLevel est la source de verite du perimetre
// (utilisee par arrondissementScopeWhere/canAccessArrondissement), separee
// des permissions RBAC (qui restent portees par les roles) :
//   CENTRAL        -> vision/consultation globale des 10 arrondissements,
//                      rattache eventuellement a un Department (service
//                      central : Etat civil, Finances, Urbanisme...).
//   ARRONDISSEMENT -> perimetre restreint aux arrondissements lies via
//                      UserArrondissement (et, si precise, aux quartiers via
//                      UserQuartier).
model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  password          String
  phone             String?
  isActive          Boolean   @default(true)
  mustResetPwd      Boolean   @default(false)
  organizationLevel String    @default("ARRONDISSEMENT") // CENTRAL | ARRONDISSEMENT
  departmentId      String?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  department               Department?              @relation(fields: [departmentId], references: [id])
  roles                    UserRole[]
  arrondissements          UserArrondissement[]
  quartiers                UserQuartier[]
  auditLogs                AuditLog[]
  agentCollecteur          AgentCollecteur?
  staffNotifications       StaffNotification[]
  technoSubscriptionAccess TechnoSubscriptionUser[]

  @@index([isActive])
  @@index([organizationLevel])
}

// Services / directions centrales de la Mairie Centrale (section "Services
// centraux"). Regroupe les utilisateurs CENTRAL par direction ; purement
// organisationnel, ne restreint pas l'acces aux donnees (les permissions
// RBAC s'en chargent).
model Department {
  id          String   @id @default(cuid())
  name        String   @unique // ex: Direction de l'Etat Civil
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  users      User[]
  complaints Complaint[]
}

// Roles minimum prevus par la specification (section 18). D'autres roles
// personnalises pourront etre ajoutes par l'administration (isSystem=false).
model Role {
  id          String   @id @default(cuid())
  code        String   @unique // ex: SUPER_ADMIN, MAYOR, ARRONDISSEMENT_HEAD, CIVIL_STATUS_AGENT...
  name        String
  description String?
  isSystem    Boolean  @default(true) // roles systeme non supprimables
  createdAt   DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]
}

// Permission granulaire = (module, action). Ex: (civil_status, validate).
// Actions possibles: view, create, edit, validate, approve, reject, sign,
// print, download, revoke, delete, export.
model Permission {
  id          String  @id @default(cuid())
  module      String // ex: civil_status, citizens, land, taxes, complaints...
  action      String // ex: view, create, edit, validate, approve, reject, sign, print, download, revoke, delete, export
  code        String  @unique // "<module>:<action>", genere a l'ecriture
  description String?

  roles RolePermission[]

  @@unique([module, action])
  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// Isolation par arrondissement (section 19). Un utilisateur sans aucune
// entree ici, mais dont un role porte hasGlobalScope=true (ex: SUPER_ADMIN,
// MAYOR), voit les 10 arrondissements. Un agent restreint est rattache a un
// ou plusieurs arrondissements precis.
model UserArrondissement {
  userId           String
  arrondissementId String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  arrondissement   Arrondissement @relation(fields: [arrondissementId], references: [id], onDelete: Cascade)

  @@id([userId, arrondissementId])
}

// Restriction plus fine, optionnelle, a l'interieur des arrondissements
// autorises ci-dessus.
model UserQuartier {
  userId     String
  quartierId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quartier   Quartier @relation(fields: [quartierId], references: [id], onDelete: Cascade)

  @@id([userId, quartierId])
}

// --- Structure territoriale ----------------------------------------------
// cities -> arrondissements -> quartiers -> sectors/zones
// Configurable: l'administration peut ajouter/modifier/desactiver une
// subdivision. N'Djamena est initialisee avec exactement 10 arrondissements
// via le seed, mais rien n'est code en dur dans l'application.

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  arrondissements Arrondissement[]
}

model Arrondissement {
  id        String   @id @default(cuid())
  cityId    String
  number    Int // 1 a 10 pour N'Djamena
  name      String
  code      String   @unique // ex: NDJ-01
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city      City                 @relation(fields: [cityId], references: [id])
  quartiers Quartier[]
  users     UserArrondissement[]

  citizens           Citizen[]
  households         Household[]
  birthRecords       BirthRecord[]
  recognitions       Recognition[]
  marriages          Marriage[]
  divorces           Divorce[]
  deathRecords       DeathRecord[]
  certificates       Certificate[]
  applications       Application[]
  subdivisions       Subdivision[]
  landParcels        LandParcel[]
  urbanPlanningCases UrbanPlanningCase[]
  businesses         Business[]
  markets            Market[]
  payments           Payment[]
  associations       Association[]
  complaints         Complaint[]
  infrastructures    Infrastructure[]
  auditLogs          AuditLog[]
  obligations        ObligationPaiement[]
  agentsCollecteurs  AgentCollecteur[]
  caisses            CashRegister[]
  versements         Versement[]
  fraudAlerts        FraudAlert[]
  tarifsMunicipaux   TarifMunicipal[]

  @@unique([cityId, number])
  @@index([cityId])
}

model Quartier {
  id               String   @id @default(cuid())
  arrondissementId String
  name             String
  code             String   @unique
  isActive         Boolean  @default(true)
  // Provenance quand le quartier vient d'une liste de travail non encore
  // validee par la mairie (regle 39 : ne jamais presenter une denomination
  // comme officielle sans confirmation) — null pour un quartier cree via
  // /admin (deja considere confirme par l'agent qui le saisit).
  sourceReference  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  arrondissement Arrondissement @relation(fields: [arrondissementId], references: [id])
  sectors        Sector[]
  users          UserQuartier[]

  citizens          Citizen[]
  households        Household[]
  landParcels       LandParcel[]
  businesses        Business[]
  markets           Market[]
  agentAffectations AgentAffectation[]
  complaints        Complaint[]

  @@index([arrondissementId])
}

model Sector {
  id         String   @id @default(cuid())
  quartierId String
  name       String
  code       String   @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  quartier Quartier @relation(fields: [quartierId], references: [id])

  citizens    Citizen[]
  households  Household[]
  landParcels LandParcel[]

  @@index([quartierId])
}

// --- PHASE 2 : ETAT CIVIL --------------------------------------------------
// Chaque enregistrement "de terrain" porte un arrondissementId obligatoire
// (l'arrondissement qui a instruit/enregistre l'acte) et est filtre cote
// serveur via recordScopeWhere() (voir rbac.ts) — jamais seulement masque
// cote client. Aucune regle juridique tchadienne n'est codee en dur : les
// statuts/regimes sont des donnees configurables, a valider par la mairie
// (regle 39 du cahier des charges).

// Dossier numerique unique par citoyen/resident.
model Citizen {
  id               String    @id @default(cuid())
  uniqueNumber     String    @unique // numero de dossier citoyen, genere a la creation
  firstName        String
  lastName         String
  sex              String // M | F
  dateOfBirth      DateTime?
  placeOfBirth     String?
  nationality      String    @default("Tchadienne")
  maritalStatus    String    @default("SINGLE") // SINGLE | MARRIED | DIVORCED | WIDOWED — mis a jour par les modules mariage/divorce/deces
  phone            String?
  address          String?
  photoUrl         String?
  isDeceased       Boolean   @default(false)
  arrondissementId String
  quartierId       String?
  sectorId         String?
  householdId      String?
  fatherId         String?
  motherId         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  arrondissement   Arrondissement @relation(fields: [arrondissementId], references: [id])
  quartier         Quartier?      @relation(fields: [quartierId], references: [id])
  sector           Sector?        @relation(fields: [sectorId], references: [id])
  household        Household?     @relation(fields: [householdId], references: [id])
  father           Citizen?       @relation("ParentChildFather", fields: [fatherId], references: [id])
  mother           Citizen?       @relation("ParentChildMother", fields: [motherId], references: [id])
  childrenAsFather Citizen[]      @relation("ParentChildFather")
  childrenAsMother Citizen[]      @relation("ParentChildMother")
  householdsHeaded Household[]    @relation("HouseholdHead")
  familiesHeaded   Family[]       @relation("FamilyHead")

  birthRecord          BirthRecord?         @relation("ChildBirthRecord")
  recognitionsAsParent Recognition[]        @relation("RecognitionParent")
  recognitionAsChild   Recognition?         @relation("RecognitionChild")
  marriagesAsHusband   Marriage[]           @relation("MarriageHusband")
  marriagesAsWife      Marriage[]           @relation("MarriageWife")
  deathRecord          DeathRecord?         @relation("DeceasedDeathRecord")
  certificates         Certificate[]
  citizenAccount       CitizenAccount?
  landParcelsOwned     LandParcel[]
  landTitlesHeld       LandTitle[]
  urbanPlanningCases   UrbanPlanningCase[]
  businessesOwned      Business[]
  marketStallsOccupied MarketStall[]
  paymentsMade         Payment[]
  associationsLed      Association[]
  obligations          ObligationPaiement[]

  @@index([arrondissementId])
  @@index([lastName, firstName])
}

// Lignee/nom de famille — regroupement large, distinct du menage
// (cohabitation). Optionnel : un citoyen peut n'avoir aucune Family associee.
model Family {
  id            String   @id @default(cuid())
  name          String // nom de famille / lignee
  headCitizenId String?
  createdAt     DateTime @default(now())

  head       Citizen?    @relation("FamilyHead", fields: [headCitizenId], references: [id])
  households Household[]
}

// Menage : unite de cohabitation, rattachee a une adresse et un
// arrondissement/quartier/secteur precis.
model Household {
  id               String   @id @default(cuid())
  code             String   @unique
  familyId         String?
  headCitizenId    String?
  address          String?
  arrondissementId String
  quartierId       String?
  sectorId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  family         Family?        @relation(fields: [familyId], references: [id])
  head           Citizen?       @relation("HouseholdHead", fields: [headCitizenId], references: [id])
  arrondissement Arrondissement @relation(fields: [arrondissementId], references: [id])
  quartier       Quartier?      @relation(fields: [quartierId], references: [id])
  sector         Sector?        @relation(fields: [sectorId], references: [id])
  members        Citizen[]

  @@index([arrondissementId])
}

// status: DECLARED | REGISTERED | RECTIFIED | ANNULLED
model BirthRecord {
  id                String    @id @default(cuid())
  recordNumber      String    @unique
  childId           String    @unique
  fatherId          String?
  motherId          String?
  dateOfBirth       DateTime
  placeOfBirth      String
  declarantName     String
  declarantRelation String?
  status            String    @default("DECLARED")
  arrondissementId  String
  createdById       String?
  registeredAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  child          Citizen        @relation("ChildBirthRecord", fields: [childId], references: [id])
  arrondissement Arrondissement @relation(fields: [arrondissementId], references: [id])
  certificates   Certificate[]
  applications   Application[]

  @@index([arrondissementId])
}

// Reconnaissance d'un enfant par un parent (pere ou mere).
// status: DECLARED | VALIDATED | ANNULLED
model Recognition {
  id               String   @id @default(cuid())
  recordNumber     String   @unique
  childId          String   @unique
  parentId         String
  parentRole       String // FATHER | MOTHER
  declarationDate  DateTime @default(now())
  status           String   @default("DECLARED")
  arrondissementId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  child          Citizen        @relation("RecognitionChild", fields: [childId], references: [id])
  parent         Citizen        @relation("RecognitionParent", fields: [parentId], references: [id])
  arrondissement Arrondissement @relation(fields: [arrondissementId], references: [id])
  certificates   Certificate[]

  @@index([arrondissementId])
}

// Regime matrimonial : liste configurable, a valider par l'administration —
// aucune regle juridique tchadienne presumee ici (regle 39).
model MarriageRegime {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  marriages Marriage[]
}

// status: DECLARED | VALID | DIVORCED | ANNULLED
model Marriage {
  id               String   @id @default(cuid())
  recordNumber     String   @unique
  husbandId        String
  wifeId           String
  marriageDate     DateTime
  marriagePlace    String
  regimeId         String?
  status           String   @default("DECLARED")
  arrondissementId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  husband        Citizen           @relation("MarriageHusband", fields: [husbandId], references: [id])
  wife           Citizen           @relation("MarriageWife", fields: [wifeId], references: [id])
  regime         MarriageRegime?   @relation(fields: [regimeId], references: [id])
  arrondissement Arrondissement    @relation(fields: [arrondissementId], references: [id])
  witnesses      MarriageWitness[]
  divorce        Divorce?
  certificates   Certificate[]
  applications   Application[]

  @@index([arrondissementId])
}

model MarriageWitness {
  id         String  @id @default(cuid())
  marriageId String
  name       String
  role       String? // ex: temoin de l'epoux / temoin de l'epouse

  marriage Marriage @relation(fields: [marriageId], references: [id], onDelete: Cascade)
}

// status: DECLARED | FINALIZED
model Divorce {
  id                String   @id @default(cuid())
  recordNumber      String   @unique
  marriageId        String   @unique
  decisionReference String?
  divorceDate       DateTime
  status            String   @default("DECLARED")
  arrondissementId  String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  marriage       Marriage       @relation(fields: [marriageId], references: [id])
  arrondissement Arrondissement @relation(fields: [arrondissementId], references: [id])
  certificates   Certificate[]

  @@index([arrondissementId])
}

// cause : champ optionnel — a n'utiliser que si legalement requis (regle 39).
// status: DECLARED | REGISTERED
model DeathRecord {
  id                String   @id @default(cuid())
  recordNumber      String   @unique
  deceasedId        String   @unique
  dateOfDeath       DateTime
  placeOfDeath      String
  cause             String?
  declarantName     String
  declarantRelation String?
  status            String   @default("DECLARED")
  arrondissementId  String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  deceased       Citizen        @relation("DeceasedDeathRecord", fields: [deceasedId], references: [id])
  arrondissement Arrondissement @relation(fields: [arrondissementId], references: [id])
  certificates   Certificate[]
  applications   Application[]

  @@index([arrondissementId])
}

// Types de documents configurables (section "Certificats municipaux") —
// aucun type n'est code en dur dans l'application.
model CertificateType {
  id          String  @id @default(cuid())
  code        String  @unique // ex: BIRTH_CERTIFICATE, RESIDENCE_CERTIFICATE
  name        String
  description String?
  isActive    Boolean @default(true)

  certificates Certificate[]
}

// Moteur de generation de documents (section 7/16) : chaque document porte
// un numero unique + un token QR verifiable publiquement, sans compte,
// via /verify/[qrToken]. La verification publique n'expose jamais de
// donnees personnelles inutiles (voir services/certificates.ts).
// status: VALID | REVOKED
model Certificate {
  id                  String    @id @default(cuid())
  documentNumber      String    @unique
  qrToken             String    @unique
  certificateTypeId   String
  citizenId           String?
  birthRecordId       String?
  recognitionId       String?
  marriageId          String?
  divorceId           String?
  deathRecordId       String?
  urbanPlanningCaseId String?
  arrondissementId    String
  authority           String    @default("Mairie de N'Djamena")
  status              String    @default("VALID")
  issuedById          String?
  issuedAt            DateTime  @default(now())
  revokedAt           DateTime?
  revokedById         String?
  revokedReason       String?

  certificateType   CertificateType    @relation(fields: [certificateTypeId], references: [id])
  citizen           Citizen?           @relation(fields: [citizenId], references: [id])
  birthRecord       BirthRecord?       @relation(fields: [birthRecordId], references: [id])
  recognition       Recognition?       @relation(fields: [recognitionId], references: [id])
  urbanPlanningCase UrbanPlanningCase? @relation(fields: [urbanPlanningCaseId], references: [id])
  marriage          Marriage?          @relation(fields: [marriageId], references: [id])
  divorce           Divorce?           @relation(fields: [divorceId], references: [id])
  deathRecord       DeathRecord?       @relation(fields: [deathRecordId], references: [id])
  arrondissement    Arrondissement     @relation(fields: [arrondissementId], references: [id])
  applications      Application[]

  @@index([arrondissementId])
  @@index([status])
}

// --- PHASE 3 : PORTAIL CITOYEN ---------------------------------------------
// Realm d'authentification separe des comptes agents (User) : un citoyen n'a
// aucune permission RBAC, uniquement un acces a ses propres donnees. Le
// compte est cree en le rattachant a un dossier Citizen existant (verifie
// par numero unique + nom), pas par simple auto-declaration.

model CitizenAccount {
  id          String    @id @default(cuid())
  citizenId   String    @unique
  email       String    @unique
  password    String
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())

  citizen               Citizen          @relation(fields: [citizenId], references: [id])
  applications          Application[]
  notifications         Notification[]
  complaints            Complaint[]
  infrastructureReports Infrastructure[]
}

// Demande citoyenne (section 15/17) : ex. copie/extrait d'un acte deja
// enregistre. arrondissementId est denormalise depuis le dossier citoyen
// pour permettre aux agents de filtrer leur file de traitement via
// recordScopeWhere() comme tout autre module.
// status: SUBMITTED | IN_REVIEW | APPROVED | REJECTED | COMPLETED
model Application {
  id                  String    @id @default(cuid())
  applicationNumber   String    @unique
  citizenAccountId    String
  type                String // BIRTH_CERTIFICATE_COPY | MARRIAGE_CERTIFICATE_COPY | DEATH_CERTIFICATE_COPY
  birthRecordId       String?
  marriageId          String?
  deathRecordId       String?
  arrondissementId    String
  status              String    @default("SUBMITTED")
  notes               String?
  reviewedById        String?
  reviewedAt          DateTime?
  rejectionReason     String?
  resultCertificateId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  citizenAccount    CitizenAccount @relation(fields: [citizenAccountId], references: [id])
  birthRecord       BirthRecord?   @relation(fields: [birthRecordId], references: [id])
  marriage          Marriage?      @relation(fields: [marriageId], references: [id])
  deathRecord       DeathRecord?   @relation(fields: [deathRecordId], references: [id])
  arrondissement    Arrondissement @relation(fields: [arrondissementId], references: [id])
  resultCertificate Certificate?   @relation(fields: [resultCertificateId], references: [id])

  @@index([arrondissementId])
  @@index([citizenAccountId])
  @@index([status])
}

// Notifications in-app (section 24). Canaux email/SMS : architecture
// prevue mais non implementee (necessiterait un fournisseur reel).
model Notification {
  id               String   @id @default(cuid())
  citizenAccountId String
  title            String
  message          String
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())

  citizenAccount CitizenAccount @relation(fields: [citizenAccountId], references: [id])

  @@index([citizenAccountId])
}

// Notifications internes agents/superviseurs/administration (section 32) —
// modele distinct de Notification (portail citoyen) : realm different,
// evite tout risque de regression sur le flux citoyen existant. Canaux
// email/SMS : architecture prevue mais non implementee (necessiterait un
// fournisseur reel), meme reserve que pour Notification.
// severity: INFO | WARNING | CRITICAL
model StaffNotification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  severity  String   @default("INFO")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

// --- PHASE 4 : FONCIER ET URBANISME ----------------------------------------
// Architecture compatible avec une future integration GIS/cartographie
// (section 8) : `location` reste un texte libre pour l'instant, a remplacer
// par des coordonnees/geometrie sans casser le reste du modele.

// Projet de lotissement — regroupe des parcelles au sein d'une zone.
model Subdivision {
  id               String   @id @default(cuid())
  name             String // nom du projet
  zone             String?
  description      String?
  status           String   @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED
  arrondissementId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  arrondissement Arrondissement @relation(fields: [arrondissementId], references: [id])
  parcels        LandParcel[]

  @@index([arrondissementId])
}

// status: AVAILABLE | OCCUPIED | DISPUTED | TITLED
model LandParcel {
  id               String   @id @default(cuid())
  parcelNumber     String   @unique
  arrondissementId String
  quartierId       String?
  sectorId         String?
  subdivisionId    String?
  area             Float? // superficie en m2
  location         String?
  ownerCitizenId   String?
  status           String   @default("AVAILABLE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  arrondissement Arrondissement      @relation(fields: [arrondissementId], references: [id])
  quartier       Quartier?           @relation(fields: [quartierId], references: [id])
  sector         Sector?             @relation(fields: [sectorId], references: [id])
  subdivision    Subdivision?        @relation(fields: [subdivisionId], references: [id])
  owner          Citizen?            @relation(fields: [ownerCitizenId], references: [id])
  title          LandTitle?
  urbanCases     UrbanPlanningCase[]

  @@index([arrondissementId])
}

// Un titre actif par parcelle dans ce modele simplifie ; l'historique des
// mutations successives est une extension future (nouvelle table
// LandTitleTransfer) plutot qu'un abus de ce modele.
// status: VALID | REVOKED
model LandTitle {
  id          String   @id @default(cuid())
  titleNumber String   @unique
  parcelId    String   @unique
  holderId    String
  issuedDate  DateTime @default(now())
  status      String   @default("VALID")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parcel LandParcel @relation(fields: [parcelId], references: [id])
  holder Citizen    @relation(fields: [holderId], references: [id])
}

// Permis de construire / autorisation de demolition (section 9).
// Workflow (section 9) : Demande -> Verification -> Instruction -> Controle
// -> Validation -> Decision -> Document officiel.
// status: SUBMITTED | UNDER_REVIEW | INSPECTED | APPROVED | REJECTED
model UrbanPlanningCase {
  id               String    @id @default(cuid())
  caseNumber       String    @unique
  type             String // BUILDING_PERMIT | DEMOLITION_PERMIT
  parcelId         String
  applicantId      String
  description      String?
  status           String    @default("SUBMITTED")
  arrondissementId String
  inspectedAt      DateTime?
  inspectionNotes  String?
  decisionAt       DateTime?
  decisionById     String?
  decisionNotes    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  parcel         LandParcel     @relation(fields: [parcelId], references: [id])
  applicant      Citizen        @relation(fields: [applicantId], references: [id])
  arrondissement Arrondissement @relation(fields: [arrondissementId], references: [id])
  certificates   Certificate[]

  @@index([arrondissementId])
  @@index([status])
}

// --- PHASE 5 : FINANCES MUNICIPALES ----------------------------------------
// Applique la hierarchie de visibilite exigee pour les recettes : chaque
// Payment porte un arrondissementId obligatoire, NULL uniquement pour une
// recette collectee directement par la Mairie Centrale (organizationLevel
// CENTRAL cote agent collecteur). Les totaux (dashboard, rapports) sont
// TOUJOURS calcules dynamiquement par agregation (groupBy/sum) via
// recordScopeWhere() — jamais code en dur. Aucun montant/taux n'est
// invente : TaxType.amount est configurable et signale comme placeholder.

// Commercant/entreprise redevable de patente = "boutique" du module
// recensement (section 8). `activity` (texte libre, historique) est
// conserve pour compatibilite ; `activityId` pointe vers le referentiel
// configurable ActiviteEconomique pour les nouvelles fiches. `code` est
// l'identifiant d'emplacement structure (section 7, ex NDJ-A01-Q05-BT-000123),
// derive de `sequence` (compteur Postgres monotone : jamais reutilise, meme
// apres suppression) au moment de la creation — jamais recalcule ensuite.
model Business {
  id               String    @id @default(cuid())
  sequence         Int       @unique @default(autoincrement())
  code             String?   @unique
  name             String
  ownerId          String
  activity         String?
  activityId       String?
  category         String?
  gpsLat           Float?
  gpsLng           Float?
  photoUrl         String?
  openedAt         DateTime?
  closedAt         DateTime?
  arrondissementId String
  quartierId       String?
  status           String    @default("ACTIVE") // ACTIVE | INACTIVE | FERMEE | SUSPENDUE | EN_ATTENTE_DE_VALIDATION
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner          Citizen              @relation(fields: [ownerId], references: [id])
  activityRef    ActiviteEconomique?  @relation(fields: [activityId], references: [id])
  arrondissement Arrondissement       @relation(fields: [arrondissementId], references: [id])
  quartier       Quartier?            @relation(fields: [quartierId], references: [id])
  payments       Payment[]
  obligations    ObligationPaiement[]

  @@index([arrondissementId])
}

// Type de taxe/patente configurable — montant PLACEHOLDER a valider par la
// mairie (regle 39), jamais presente comme un bareme officiel.
model TaxType {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  amount      Float? // montant de reference, configurable, non contractuel
  description String?
  isActive    Boolean @default(true)

  payments Payment[]
}

// `code` = identifiant d'emplacement structure (section 7, ex NDJ-A01-MKT-000001),
// derive de `sequence` au moment de la creation, jamais reutilise.
// status: ACTIVE | INACTIVE | FERME (section 6)
model Market {
  id               String   @id @default(cuid())
  sequence         Int      @unique @default(autoincrement())
  code             String?  @unique
  name             String
  address          String?
  gpsLat           Float?
  gpsLng           Float?
  responsibleName  String?
  description      String?
  photoUrl         String?
  status           String   @default("ACTIVE")
  arrondissementId String
  quartierId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  arrondissement Arrondissement     @relation(fields: [arrondissementId], references: [id])
  quartier       Quartier?          @relation(fields: [quartierId], references: [id])
  stalls         MarketStall[]
  affectations   AgentAffectation[]
}

// L'emplacement precis au sein d'un marche (etal, kiosque, hangar, place...) ;
// `code` reste le petit identifiant local unique dans le marche (ex "A12"),
// combine a Market.code pour un reperage complet sur le terrain.
model MarketStall {
  id         String   @id @default(cuid())
  marketId   String
  code       String
  type       String? // ETAL | KIOSQUE | HANGAR | PLACE | AUTRE
  status     String   @default("AVAILABLE") // AVAILABLE | OCCUPIED | RESERVED | SUSPENDED
  occupantId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  market      Market               @relation(fields: [marketId], references: [id])
  occupant    Citizen?             @relation(fields: [occupantId], references: [id])
  payments    Payment[]
  obligations ObligationPaiement[]

  @@unique([marketId, code])
}

// Recette municipale. arrondissementId obligatoire (NULL = Mairie Centrale
// uniquement). Champs alignes sur la structure demandee : payment_id,
// receipt_number, payer_id, amount, payment_date, payment_method, tax_type,
// market_id (via marketStallId), business_id, arrondissement_id, collected_by, status.
// obligationId/agentId relient le paiement a la chaine recensement -> tarif
// -> obligation -> collecte (module "recettes municipales"). collectedById
// reste l'ID brut de l'acteur (retro-compatible) : un UserId pour une
// collecte agent/caisse, un CitizenAccount.id pour un paiement en ligne
// initie par le contribuable lui-meme (module paiement en ligne, section 9).
// NULL = paiement QR anonyme (module paiement QR, section 41 : aucun compte
// requis) — aucun acteur identifie ne collecte ce paiement, voir
// services/qr-payments.ts. agentId est la relation forte vers sa fiche AgentCollecteur quand la collecte passe par
// l'app de terrain plutot qu'un enregistrement direct par un agent central.
// gpsLat/gpsLng : capture passive de la position lors d'une collecte mobile
// (section 25) — jamais bloquant, uniquement informatif/controle a posteriori.
// status: PAID | PENDING | OVERDUE | ANNULE (annulation = section 16, jamais
// une suppression : voir PaymentCancellation)
model Payment {
  id               String   @id @default(cuid())
  receiptNumber    String   @unique
  payerId          String
  amount           Float
  paymentDate      DateTime @default(now())
  paymentMethod    String // ESPECES | MOBILE_MONEY | VIREMENT | CARTE | EN_LIGNE | AUTRE — extensible (section 25)
  taxTypeId        String?
  businessId       String?
  marketStallId    String?
  obligationId     String?
  agentId          String?
  caisseId         String?
  arrondissementId String?
  collectedById    String?
  gpsLat           Float?
  gpsLng           Float?
  // PAID | PENDING | OVERDUE | ANNULE | ECHEC | REMBOURSE — un paiement
  // mediatise par un prestataire reste PENDING (aucun reçu, aucune
  // imputation d'obligation) jusqu'a confirmation reelle (voir
  // services/mobile-money.ts et services/payment-provider.ts).
  status           String   @default("PAID")
  // Cle d'idempotence generee cote client (module collecte hors ligne,
  // section 22) : une soumission en file d'attente locale rejouee apres
  // resynchronisation renvoie le paiement deja cree au lieu d'en creer un
  // second — jamais de double encaissement pour une meme intention de
  // paiement. Null pour tout paiement enregistre en ligne normalement.
  clientRequestId  String?  @unique
  createdAt        DateTime @default(now())

  payer          Citizen                 @relation(fields: [payerId], references: [id])
  taxType        TaxType?                @relation(fields: [taxTypeId], references: [id])
  business       Business?               @relation(fields: [businessId], references: [id])
  marketStall    MarketStall?            @relation(fields: [marketStallId], references: [id])
  obligation     ObligationPaiement?     @relation(fields: [obligationId], references: [id])
  agent          AgentCollecteur?        @relation(fields: [agentId], references: [id])
  caisse         CashRegister?           @relation(fields: [caisseId], references: [id])
  arrondissement Arrondissement?         @relation(fields: [arrondissementId], references: [id])
  receipt        Receipt?
  cancellation   PaymentCancellation?
  mobileMoney    MobileMoneyTransaction?
  refund         PaymentRefund?
  fraudAlerts    FraudAlert[]

  @@index([arrondissementId])
  @@index([paymentDate])
  @@index([obligationId])
  @@index([agentId])
  @@index([caisseId])
}

// --- PHASE 6 : SERVICES MUNICIPAUX ------------------------------------------

// Associations et ONG locales (section 12). Registre gere par les agents ;
// pas d'espace citoyen dedie a ce stade.
// status: REGISTERED | SUSPENDED | DISSOLVED
model Association {
  id                 String   @id @default(cuid())
  registrationNumber String   @unique
  name               String
  type               String? // ex: culturelle, sportive, humanitaire, ONG
  leaderId           String?
  arrondissementId   String
  status             String   @default("REGISTERED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  leader         Citizen?       @relation(fields: [leaderId], references: [id])
  arrondissement Arrondissement @relation(fields: [arrondissementId], references: [id])

  @@index([arrondissementId])
}

// Categorie de signalement, administrable (module Plaintes & Doleances,
// section 6) — remplace la liste figee CATEGORIES codee en dur dans
// complaints.ts. Seed initial : une ligne par ancien code (VOIRIE,
// PROPRETE, ECLAIRAGE, EAU, SECURITE, AUTRE) pour que les plaintes
// existantes restent coherentes une fois `Complaint.categoryId` renseigne.
model ComplaintCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  subcategories ComplaintSubcategory[]
  complaints    Complaint[]
}

model ComplaintSubcategory {
  id         String  @id @default(cuid())
  categoryId String
  code       String
  name       String
  isActive   Boolean @default(true)

  category   ComplaintCategory @relation(fields: [categoryId], references: [id])
  complaints Complaint[]

  @@unique([categoryId, code])
}

// Guichet numerique des plaintes (module Plaintes & Doleances). Soumise
// depuis le portail citoyen ; suivie par les agents avec un historique
// d'etapes (ComplaintUpdate) et un workflow a 13 etats (voir
// src/lib/services/complaints.ts pour la table de transitions autorisees) :
// DRAFT | SUBMITTED | RECEIVED | VERIFYING | NEEDS_INFO | ASSIGNED_DEPT |
// ASSIGNED_AGENT | IN_PROGRESS | WAITING | RESOLVED | VALIDATING | CLOSED |
// REJECTED — remplace l'ancien statut simplifie a 7 valeurs (NEW/RECEIVED/
// ASSIGNED/IN_PROGRESS/PENDING/RESOLVED/CLOSED), conserve en compatibilite
// via la meme colonne `status` (String libre, pas d'enum — convention deja
// suivie par tout le reste du schema).
//
// La plupart des nouveaux champs sont optionnels : les plaintes existantes
// (creees avant cette migration) restent valides sans backfill obligatoire,
// seuls category/categoryId different (categoryId sera backfille depuis
// l'ancien champ `category` par la migration elle-meme).
model Complaint {
  id               String    @id @default(cuid())
  caseNumber       String    @unique
  sequence         Int       @default(autoincrement()) // pour generateComplaintNumber() — meme convention que Receipt.sequence
  type             String    @default("PLAINTE") // PLAINTE | DOLEANCE | SIGNALEMENT | SUGGESTION | RECLAMATION | INTERVENTION | URGENCE
  citizenAccountId String
  category         String // ancien champ libre, conserve pour compatibilite — voir categoryId
  categoryId       String?
  subcategoryId    String?
  title            String? // "Objet" (section 8) — optionnel : absent sur les plaintes anterieures a cette migration
  description      String
  priority         String    @default("NORMAL") // FAIBLE | NORMAL | IMPORTANT | URGENT | CRITIQUE
  status           String    @default("SUBMITTED")
  arrondissementId String
  quartierId       String?
  address          String?
  landmark         String? // "point de repere"
  latitude         Float?
  longitude        Float?
  problemAt        DateTime? // date/heure du probleme, facultative (section 8)

  assignedDepartmentId String?
  assignedToId         String? // agent responsable
  supervisorId         String?

  receivedAt   DateTime?
  assignedAt   DateTime?
  startedAt    DateTime?
  dueAt        DateTime? // echeance SLA (section 16)
  slaHours     Int? // delai cible fige au moment de l'affectation, selon la priorite
  resolvedAt   DateTime?
  validatedAt  DateTime?
  closedAt     DateTime?

  resolutionNotes String?
  rejectionReason String?
  mergedIntoId    String? // detection de doublons (section 26) : ce dossier a ete fusionne dans un autre
  deletedAt       DateTime? // soft delete (section 43) — jamais de suppression physique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  citizenAccount     CitizenAccount         @relation(fields: [citizenAccountId], references: [id])
  arrondissement     Arrondissement         @relation(fields: [arrondissementId], references: [id])
  quartier           Quartier?              @relation(fields: [quartierId], references: [id])
  categoryRef        ComplaintCategory?     @relation(fields: [categoryId], references: [id])
  subcategoryRef     ComplaintSubcategory?  @relation(fields: [subcategoryId], references: [id])
  assignedDepartment Department?            @relation(fields: [assignedDepartmentId], references: [id])
  mergedInto         Complaint?             @relation("ComplaintMerge", fields: [mergedIntoId], references: [id])
  mergedFrom         Complaint[]            @relation("ComplaintMerge")
  updates            ComplaintUpdate[]
  attachments        ComplaintAttachment[]
  comments           ComplaintComment[]
  satisfaction       ComplaintSatisfaction?
  escalations        ComplaintEscalation[]

  @@index([arrondissementId])
  @@index([status])
  @@index([priority])
  @@index([categoryId])
  @@index([assignedToId])
  @@index([dueAt])
}

// Historique des etapes de traitement — visible par le citoyen dans son
// suivi de dossier (section 17 : timeline complete).
model ComplaintUpdate {
  id          String   @id @default(cuid())
  complaintId String
  status      String
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

// Pieces jointes (section 9) — metadonnees uniquement ; le fichier lui-meme
// vit hors base (voir docs de stockage existantes, meme convention que
// Certificate/CitizenDocument : jamais de BYTEA en base pour un fichier).
// `uploadedByCitizenAccountId` XOR `uploadedByUserId` selon l'auteur.
model ComplaintAttachment {
  id                         String   @id @default(cuid())
  complaintId                String
  fileName                   String
  storagePath                String
  mimeType                   String
  sizeBytes                  Int
  uploadedByCitizenAccountId String?
  uploadedByUserId           String?
  createdAt                  DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

// Messagerie citoyen <-> mairie liee au dossier (section 18). `authorType`
// distingue l'emetteur puisque AuditLog.userId ne peut pas referencer un
// CitizenAccount (meme contrainte que logAudit, voir audit.ts).
model ComplaintComment {
  id                 String   @id @default(cuid())
  complaintId        String
  authorType         String // CITIZEN | STAFF
  authorUserId       String?
  authorCitizenId    String?
  message            String
  createdAt          DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

// Evaluation de satisfaction post-resolution (section 28) — une seule par
// dossier.
model ComplaintSatisfaction {
  id           String   @id @default(cuid())
  complaintId  String   @unique
  wasResolved  String // OUI | PARTIEL | NON
  rating       Int // 1 a 5
  comment      String?
  createdAt    DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
}

// Escalade (section 27) — trace chaque saut de niveau (agent -> superviseur
// -> directeur -> administration centrale), independamment de
// ComplaintUpdate qui trace les changements de statut.
model ComplaintEscalation {
  id          String   @id @default(cuid())
  complaintId String
  fromLevel   String
  toLevel     String
  reason      String?
  createdById String
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

// Voirie et infrastructures (section 14). Le citoyen peut signaler un
// probleme depuis le portail ; `location` reste un texte libre en attendant
// une future integration GIS (meme convention que LandParcel).
// status: REPORTED | IN_PROGRESS | COMPLETED
model Infrastructure {
  id               String    @id @default(cuid())
  reportNumber     String    @unique
  type             String // ROAD | LIGHTING | DRAINAGE | WASTE | PUBLIC_SPACE | OTHER
  description      String
  location         String?
  status           String    @default("REPORTED")
  arrondissementId String
  reportedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  arrondissement Arrondissement  @relation(fields: [arrondissementId], references: [id])
  reportedBy     CitizenAccount? @relation(fields: [reportedById], references: [id])

  @@index([arrondissementId])
  @@index([status])
}

// --- Audit log -------------------------------------------------------------
// Non modifiable par les agents ordinaires (aucune route d'edition/suppression
// n'est exposee ; ecriture uniquement depuis le serveur via logAudit()).

model AuditLog {
  id               String   @id @default(cuid())
  userId           String?
  userName         String // capture au moment de l'action, resiste a la suppression du compte
  action           String // ex: CREATE, UPDATE, DELETE, VALIDATE, APPROVE, REJECT, SIGN, REVOKE, LOGIN, LOGIN_FAILED
  module           String // ex: auth, territorial, users, civil_status...
  entityType       String? // ex: Arrondissement, User, Role
  entityId         String?
  // Arrondissement de l'ENTITE concernee par l'action (pas forcement celui de
  // l'acteur : un admin central peut agir sur un dossier d'arrondissement).
  // null = action de portee centrale/systeme (auth, gestion des comptes,
  // roles...), visible uniquement depuis la Mairie Centrale. Meme convention
  // que recordScopeWhere() (voir rbac.ts) pour tous les modules operationnels.
  arrondissementId String?
  oldValue         Json?
  newValue         Json?
  ipAddress        String?
  userAgent        String?
  result           String   @default("SUCCESS") // SUCCESS | FAILURE
  createdAt        DateTime @default(now())

  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  arrondissement Arrondissement? @relation(fields: [arrondissementId], references: [id], onDelete: SetNull)

  @@index([module, createdAt])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([arrondissementId, createdAt])
}

// --- PHASE 7 : RECETTES MUNICIPALES — RECENSEMENT, TARIFICATION, AGENTS,
// OBLIGATIONS, REÇUS -----------------------------------------------------
// Chaine complete (cahier des charges "recettes municipales") :
// RECENSEMENT -> CONTRIBUABLE (Citizen) -> ACTIVITE -> MARCHE/BOUTIQUE
// (Market/Business, deja existants, etendus ci-dessus) -> TARIFICATION
// (TarifMunicipal) -> OBLIGATION (ObligationPaiement) -> COLLECTE (AgentCollecteur)
// -> PAIEMENT (Payment, etendu) -> REÇU (Receipt) -> CONTROLE/AUDIT (AuditLog).
// Meme convention territoriale que le reste de l'application : chaque table
// operationnelle porte un arrondissementId et est filtree via
// recordScopeWhere() cote serveur (jamais seulement masquee cote client).

// Referentiel des activites economiques (section 9), configurable par un
// administrateur autorise — aucune liste figee dans le code.
model ActiviteEconomique {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  businesses Business[]
  tarifs     TarifMunicipal[]
}

// Referentiel tarifaire municipal (section 10). Un tarif n'est JAMAIS
// modifie/ecrase : toute revision cree une nouvelle ligne (nouvelle version),
// l'ancienne recevant une endDate. Les obligations deja generees conservent
// leur reference vers le tarif applicable au moment du calcul (tracabilite).
// Montants PLACEHOLDER tant qu'un bareme officiel n'est pas fourni (regle 39,
// meme logique que TaxType.amount).
model TarifMunicipal {
  id               String    @id @default(cuid())
  // `code` n'est PAS unique : chaque revision (section 10) cree une nouvelle
  // ligne partageant le meme code, l'ancienne etant cloturee (status=INACTIF,
  // endDate renseignee) par createOrReviseTariff() — jamais ecrasee. Un seul
  // ACTIF par code a un instant donne est garanti par ce meme service.
  code             String
  label            String
  category         String?
  activityId       String?
  emplacementType  String // BOUTIQUE | MARCHE | ETAL | AUTRE
  periodicity      String // JOURNALIERE | HEBDOMADAIRE | MENSUELLE | TRIMESTRIELLE | SEMESTRIELLE | ANNUELLE | AUTRE
  unit             String? // ex "m2", "emplacement", "forfait" — unite sur laquelle `amount` s'applique (module paiement en ligne, section 5)
  amount           Float
  // null = tarif valable pour toute la ville ; renseigne = specifique a un
  // arrondissement (module paiement en ligne, section 5). Un tarif ville-wide
  // et un tarif specifique au meme `code` peuvent coexister ; le moteur de
  // calcul prend le plus specifique.
  arrondissementId String?
  startDate        DateTime  @default(now())
  endDate          DateTime?
  status           String    @default("ACTIF") // ACTIF | INACTIF
  legalReference   String?
  createdById      String?
  createdAt        DateTime  @default(now())

  activity       ActiviteEconomique?  @relation(fields: [activityId], references: [id])
  arrondissement Arrondissement?      @relation(fields: [arrondissementId], references: [id])
  obligations    ObligationPaiement[]

  @@index([code])
  @@index([emplacementType])
  @@index([status])
  @@index([arrondissementId])
}

// Somme due generee pour un contribuable/emplacement sur une periode donnee
// (section 11). solde = initialAmount - paidAmount, jamais negatif (verifie
// en code service, pas de contrainte SQL pour rester compatible paiements
// partiels successifs).
// status: A_PAYER | PARTIELLEMENT_PAYE | PAYE | EN_RETARD | ANNULE
model ObligationPaiement {
  id               String   @id @default(cuid())
  number           String   @unique
  citizenId        String
  businessId       String?
  marketStallId    String?
  tarifId          String
  period           String // ex "2026-08" (mensuel), "2026" (annuel), ou date ISO (journalier)
  initialAmount    Float
  // Penalite/remise : montants structurels, jamais calcules automatiquement
  // par un taux invente (regle absolue : ne jamais inventer une penalite).
  // Restent a 0 tant qu'aucun texte officiel ne fixe une regle de calcul ;
  // saisie manuelle par un agent autorise en attendant (module paiement en
  // ligne, section 6/19).
  penaltyAmount    Float    @default(0)
  discountAmount   Float    @default(0)
  paidAmount       Float    @default(0)
  dueDate          DateTime
  // A_PAYER | PARTIELLEMENT_PAYE | PAYE | EN_RETARD | ANNULE | REMBOURSE
  status           String   @default("A_PAYER")
  arrondissementId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  citizen        Citizen              @relation(fields: [citizenId], references: [id])
  business       Business?            @relation(fields: [businessId], references: [id])
  marketStall    MarketStall?         @relation(fields: [marketStallId], references: [id])
  tarif          TarifMunicipal       @relation(fields: [tarifId], references: [id])
  arrondissement Arrondissement       @relation(fields: [arrondissementId], references: [id])
  payments       Payment[]
  reminders      ObligationReminder[]

  @@index([arrondissementId])
  @@index([status])
  @@index([citizenId])
}

// Trace d'une relance envoyee (module paiement en ligne, section 19 :
// J-7 rappel, J-1 rappel, J+1 facture echue, J+7 relance — echeancier fixe
// par la note officielle, jamais invente ici). La contrainte d'unicite est
// le mecanisme d'idempotence : executer runDueReminders() plusieurs fois le
// meme jour (ex. cron redemarre) ne renvoie jamais deux fois la meme relance.
model ObligationReminder {
  id           String   @id @default(cuid())
  obligationId String
  type         String // J-7 | J-1 | J+1 | J+7
  sentAt       DateTime @default(now())
  notified     Boolean  @default(false) // true si une Notification in-app a bien ete creee
  smsSent      Boolean  @default(false) // true si sendSms() a reellement transmis (jamais suppose)

  obligation ObligationPaiement @relation(fields: [obligationId], references: [id])

  @@unique([obligationId, type])
}

// Fiche agent collecteur (section 12), rattachee a un compte User existant
// (authentification/RBAC reutilises, pas de realm separe). matricule genere
// a la creation, jamais reutilise.
// status: ACTIF | SUSPENDU | INACTIF
model AgentCollecteur {
  id               String   @id @default(cuid())
  matricule        String   @unique
  userId           String   @unique
  phone            String?
  photoUrl         String?
  status           String   @default("ACTIF")
  arrondissementId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User               @relation(fields: [userId], references: [id])
  arrondissement Arrondissement     @relation(fields: [arrondissementId], references: [id])
  affectations   AgentAffectation[]
  payments       Payment[]
  caisses        CashRegister[]
  versements     Versement[]
  fraudAlerts    FraudAlert[]

  @@index([arrondissementId])
}

// Affectation d'un agent a une zone de collecte (quartier ou marche precis),
// historisee (section 12 : "Historiser toutes les affectations") — une
// nouvelle affectation ne supprime jamais l'ancienne, elle la cloture
// (endDate + isActive=false) et en cree une nouvelle.
model AgentAffectation {
  id          String    @id @default(cuid())
  agentId     String
  zoneType    String // QUARTIER | MARCHE
  quartierId  String?
  marketId    String?
  startDate   DateTime  @default(now())
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())

  agent    AgentCollecteur @relation(fields: [agentId], references: [id])
  quartier Quartier?       @relation(fields: [quartierId], references: [id])
  market   Market?         @relation(fields: [marketId], references: [id])

  @@index([agentId])
}

// Reçu officiel (section 18), 1:1 avec le Payment qu'il documente. `sequence`
// est un compteur Postgres monotone (jamais reutilise, meme apres annulation)
// qui sert a formatter `number` (REC-<annee>-<sequence sur 8 chiffres>).
// `qrToken` suit exactement la meme convention que Certificate.qrToken :
// verification publique via /verify-receipt, sans exposer de donnees
// personnelles (section 19).
// status: VALIDE | ANNULE
model Receipt {
  id         String    @id @default(cuid())
  sequence   Int       @unique @default(autoincrement())
  number     String    @unique
  paymentId  String    @unique
  qrToken    String    @unique
  status     String    @default("VALIDE")
  voidedAt   DateTime?
  voidedById String?
  voidReason String?
  createdAt  DateTime  @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
}

// Annulation d'un paiement valide (regle absolue #1 et #6 : jamais de
// suppression, motif toujours obligatoire, action journalisee dans
// AuditLog). Le Payment original reste visible integralement ; seul son
// `status` passe a "ANNULE".
model PaymentCancellation {
  id              String   @id @default(cuid())
  paymentId       String   @unique
  reason          String
  cancelledById   String
  cancelledByName String
  createdAt       DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
}

// --- PHASE 8 : CAISSES, VERSEMENTS, MOBILE MONEY, CONTROLE ANTI-FRAUDE -----
// Suite du module "recettes municipales" : un agent ouvre une caisse, opere
// des collectes (Payment.caisseId), la cloture avec un montant declare ->
// l'ecart eventuel genere automatiquement une FraudAlert (section 20/22).
// Le Mobile Money suit un cycle honnete : INITIATED -> PENDING -> SUCCESS
// (le paiement ne devient PAID, l'obligation n'est impute et le reçu n'est
// genere qu'A LA CONFIRMATION — jamais simule, voir services/mobile-money.ts).

// status: OUVERTE | CLOTUREE | RAPPROCHEE
model CashRegister {
  id               String    @id @default(cuid())
  number           String    @unique
  agentId          String
  arrondissementId String
  openedAt         DateTime  @default(now())
  openedById       String
  closedAt         DateTime?
  closedById       String?
  // Calcules a la cloture : somme des paiements ESPECES lies a cette caisse
  // (seul l'argent physique est reconcilie) vs montant reellement compte par
  // l'agent. Jamais recalcules apres coup — figes au moment de la cloture.
  expectedAmount   Float?
  declaredAmount   Float?
  discrepancy      Float?
  status           String    @default("OUVERTE")
  createdAt        DateTime  @default(now())

  agent          AgentCollecteur @relation(fields: [agentId], references: [id])
  arrondissement Arrondissement  @relation(fields: [arrondissementId], references: [id])
  payments       Payment[]
  versements     Versement[]
  fraudAlerts    FraudAlert[]

  @@index([agentId])
  @@index([arrondissementId])
}

// Remise des especes collectees a la structure habilitee (section 21).
// status: EN_ATTENTE | VALIDE | ECART | REJETE
model Versement {
  id               String    @id @default(cuid())
  number           String    @unique
  agentId          String
  caisseId         String?
  expectedAmount   Float
  remittedAmount   Float
  discrepancy      Float
  justification    String?
  status           String    @default("EN_ATTENTE")
  validatedById    String?
  validatedAt      DateTime?
  arrondissementId String
  createdAt        DateTime  @default(now())

  agent          AgentCollecteur @relation(fields: [agentId], references: [id])
  caisse         CashRegister?   @relation(fields: [caisseId], references: [id])
  arrondissement Arrondissement  @relation(fields: [arrondissementId], references: [id])

  @@index([agentId])
  @@index([arrondissementId])
}

// Transaction Mobile Money (section 17), 1:1 avec le Payment qu'elle
// documente. `externalReference` est UNIQUE : c'est le mecanisme
// d'idempotence garantissant qu'une meme transaction prestataire n'est
// jamais enregistree deux fois (regle absolue #5). `provider` reste
// configurable (aucun operateur code en dur) ; "MANUAL" tant qu'aucun
// prestataire n'est effectivement contractualise — la confirmation se fait
// alors via une action administrative explicite plutot qu'un faux succes
// automatique.
// status: INITIATED | PENDING | SUCCESS | FAILED | CANCELLED | REFUNDED
// Sert de table `PaymentTransaction` generique (module paiement en ligne,
// section 11) pour tout paiement mediatise par un prestataire : collecte
// Mobile Money par un agent sur le terrain (channel=AGENT, historique),
// paiement en ligne initie par le contribuable depuis /portail
// (channel=ONLINE), et paiement anonyme depuis un scan QR public (channel=QR,
// module paiement QR, section 41 — voir services/qr-payments.ts). Le nom du modele est
// conserve pour ne pas casser l'existant (regle absolue : ne pas
// reconstruire inutilement) ; `provider` reste une chaine libre, jamais un
// operateur code en dur. externalReference reste l'idempotence prestataire ;
// internalReference est notre propre reference, generee avant meme l'appel
// au prestataire (utile pour retrouver une transaction dont l'appel
// prestataire a echoue avant de recevoir une reference externe).
model MobileMoneyTransaction {
  id                 String    @id @default(cuid())
  paymentId          String    @unique
  provider           String    @default("MANUAL")
  channel            String    @default("AGENT") // AGENT | ONLINE | QR
  internalReference  String?   @unique
  externalReference  String?   @unique
  phoneNumber        String?
  amount             Float
  currency           String    @default("XAF")
  // INITIATED | PENDING | SUCCESS | FAILED | CANCELLED | REFUNDED
  status             String    @default("INITIATED")
  providerResponse   Json?
  failureReason      String?
  initiatedAt        DateTime  @default(now())
  callbackReceivedAt DateTime?
  verifiedAt         DateTime?
  confirmedAt        DateTime?
  confirmedById      String?

  payment                Payment                @relation(fields: [paymentId], references: [id])
  reconciliationEntries  ReconciliationEntry[]
}

// Rapprochement prestataire/banque (module paiement QR, section 31) —
// distinct de CashRegister/Versement qui ne reconcilient que l'especes
// physique : ici on compare les MobileMoneyTransaction internes a un
// releve externe (banque/prestataire) televerse par un agent central.
// Traitement synchrone (pas de file d'attente async dans ce projet) :
// le lot est immediatement complet des sa creation.
model ReconciliationBatch {
  id                     String   @id @default(cuid())
  provider               String
  periodStart            DateTime
  periodEnd              DateTime
  fileName               String
  uploadedById           String
  matchedCount           Int      @default(0)
  mismatchCount          Int      @default(0)
  missingInternalCount   Int      @default(0)
  unmatchedExternalCount Int      @default(0)
  createdAt              DateTime @default(now())

  entries ReconciliationEntry[]
}

// Une ligne par entree du releve OU par transaction interne orpheline
// (voir ingestReconciliationStatement()) — jamais les deux a la fois.
// status : MATCHED | AMOUNT_MISMATCH | MISSING_INTERNAL | UNMATCHED_EXTERNAL.
// `resolved` est independant de `status` (qui reste la classification du
// rapprochement, jamais reecrite) : un ecart resolu reste un ecart trace,
// simplement investigue.
model ReconciliationEntry {
  id                       String    @id @default(cuid())
  batchId                  String
  externalReference        String?
  statementAmount          Float?
  statementDate            DateTime?
  mobileMoneyTransactionId String?
  status                   String
  resolved                 Boolean   @default(false)
  resolvedById             String?
  resolvedAt               DateTime?
  resolutionNotes          String?
  createdAt                DateTime  @default(now())

  batch                  ReconciliationBatch     @relation(fields: [batchId], references: [id])
  mobileMoneyTransaction MobileMoneyTransaction? @relation(fields: [mobileMoneyTransactionId], references: [id])

  @@index([batchId])
  @@index([status])
}

// Remboursement d'un paiement confirme (module paiement en ligne, section
// 8/17). Jamais de suppression du Payment original — celui-ci passe au
// statut REMBOURSE, et cette ligne conserve la trace complete (motif
// obligatoire, auteur, montant). Un paiement ne peut avoir qu'un seul
// remboursement (relation 1:1) : un remboursement partiel reste un montant
// inferieur au paiement, jamais une deuxieme ligne.
model PaymentRefund {
  id                String    @id @default(cuid())
  paymentId         String    @unique
  amount            Float
  reason            String
  status            String    @default("INITIATED") // INITIATED | COMPLETED | FAILED
  providerReference String?
  requestedById     String
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  payment Payment @relation(fields: [paymentId], references: [id])
}

// Alerte generee par le moteur de controle anti-fraude (section 22/23).
// type: DOUBLE_PAYMENT | DOUBLE_RECEIPT | FORBIDDEN_MODIFICATION |
//   EXCESSIVE_CANCELLATIONS | CASH_DISCREPANCY | OUT_OF_ZONE |
//   UNKNOWN_DEVICE | SUSPICIOUS_VOLUME | OFF_HOURS | SUSPICIOUS_RECEIPT |
//   QR_INVALID_REUSE | QR_SCAN_ANOMALY | RECONCILIATION_DISCREPANCY
// severity: LOW | MEDIUM | HIGH | CRITICAL — seuils configurables, voir
// services/fraud.ts. status: OUVERTE | RESOLUE | IGNOREE
model FraudAlert {
  id               String    @id @default(cuid())
  type             String
  severity         String
  description      String
  agentId          String?
  paymentId        String?
  caisseId         String?
  qrCodeId         String?
  arrondissementId String?
  status           String    @default("OUVERTE")
  resolvedById     String?
  resolvedAt       DateTime?
  resolutionNotes  String?
  createdAt        DateTime  @default(now())

  agent          AgentCollecteur? @relation(fields: [agentId], references: [id])
  payment        Payment?         @relation(fields: [paymentId], references: [id])
  caisse         CashRegister?    @relation(fields: [caisseId], references: [id])
  qrCode         QrCode?          @relation(fields: [qrCodeId], references: [id])
  arrondissement Arrondissement?  @relation(fields: [arrondissementId], references: [id])

  @@index([status])
  @@index([severity])
  @@index([arrondissementId])
}

// --- PHASE 9 : QR PAIEMENT & RECETTE NUMERIQUE ------------------------------
// Systeme QR reutilisable (module paiement QR, section 3) : entityType/
// entityId forme une reference polymorphe DELIBEREE (pas de FK Prisma stricte
// possible vers plusieurs modeles a la fois) plutot qu'un champ qrToken pose
// sur chaque table cible (Business, MarketStall, et toute autre a l'avenir) —
// ajouter un nouveau type d'entite QR-able ne touche jamais ce modele ni le
// moteur de paiement (section 3 : "without modifying the core payment
// architecture"). La validite de entityType/entityId est verifiee en code
// service (qr-codes.ts) au moment de la generation, jamais en base.
// status: ACTIVE | REVOKED | REPLACED
model QrCode {
  id            String    @id @default(cuid())
  token         String    @unique // valeur encodee dans le QR (URL /pay/<token>) — public, non devinable, ne contient jamais le montant (regle absolue section 2)
  entityType    String // BUSINESS | MARKET_STALL
  entityId      String
  status        String    @default("ACTIVE")
  issuedAt      DateTime  @default(now())
  issuedById    String?
  revokedAt     DateTime?
  revokedById   String?
  revokedReason String?
  replacesId    String?   @unique // QR precedent que celui-ci remplace (section 25 : perte/vol/degradation)
  installedAt   DateTime?
  installedById String?
  installGpsLat Float?
  installGpsLng Float?
  createdAt     DateTime  @default(now())

  replaces    QrCode?       @relation("QrReplacement", fields: [replacesId], references: [id])
  replacedBy  QrCode?       @relation("QrReplacement")
  events      QrCodeEvent[]
  fraudAlerts FraudAlert[]

  @@index([entityType, entityId])
  @@index([status])
}

// Journal d'evenements QR (section 35/39) — GENERATED | PRINTED | INSTALLED |
// SCANNED | SCANNED_BY_AGENT | PAYMENT_INITIATED | REVOKED | REPLACED. Une
// ligne par evenement, jamais modifiee ni supprimee (meme regle que
// AuditLog) ; distinct de QrCode qui ne porte que l'etat courant.
model QrCodeEvent {
  id        String   @id @default(cuid())
  qrCodeId  String
  event     String
  actorId   String?
  metadata  Json?
  createdAt DateTime @default(now())

  qrCode QrCode @relation(fields: [qrCodeId], references: [id])

  @@index([qrCodeId])
  @@index([event])
}

// --- Parametres systeme -----------------------------------------------------

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

// =============================================================================
// TECHNOTCHAD — GESTION DES ABONNEMENTS ET LICENCES (editeur logiciel)
// =============================================================================
// Sous-systeme COMMERCIAL de l'editeur TECHNOTCHAD, deliberement separe des
// donnees METIER municipales de SIGEC-SM (regle absolue de la specification :
// TECHNOTCHAD gere la commercialisation/licence, jamais les donnees
// personnelles des citoyens). Acces controle exclusivement par des
// permissions dediees "technotchad_*" — jamais incluses dans le "ALL" du
// role municipal SUPER_ADMIN (voir l'exclusion explicite dans prisma/seed.ts).
// Pas de scoping territorial (recordScopeWhere/arrondissementId) sur ces
// tables : ce n'est pas une donnee d'arrondissement, c'est une donnee
// "client logiciel" au sens commercial — l'isolation ici est par permission
// de role technotchad_*, pas par perimetre geographique.
//
// PORTEE DE CETTE PREMIERE PHASE (sur ~40 tables/fonctions demandees par la
// specification complete) : le modele de donnees central (client, produit,
// plan, contrat, abonnement, licence, modules, sites, utilisateurs autorises)
// + le RBAC dedie + un seed reel pour le seul client existant (Ville de
// N'Djamena / SIGEC-SM). Explicitement PAS construits dans cette phase :
// facturation/paiements/recus TECHNOTCHAD, moteur d'automatisation des
// suspensions/relances, API de validation de licence + mode hors-ligne,
// notifications, verification publique par QR, rapports/exports, application
// de la limite max_users dans le flux de creation d'utilisateur existant —
// a livrer en phases suivantes une fois ce socle valide.

// TECH-CLI-000001 — Codes clients TECHNOTCHAD, jamais reutilises.
model TechnoClient {
  id             String   @id @default(cuid())
  clientCode     String   @unique
  legalName      String
  commercialName String?
  clientType     String // MAIRIE | ENTREPRISE | ADMINISTRATION | ONG | ASSOCIATION | PARTICULIER | AUTRE
  country        String   @default("Tchad")
  city           String?
  address        String?
  phone          String?
  email          String?
  contactPerson  String?
  taxNumber      String?
  status         String   @default("ACTIVE") // ACTIVE | INACTIVE | SUSPENDED | TERMINATED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contracts     TechnoContract[]
  subscriptions TechnoSubscription[]
  sites         TechnoSubscriptionSite[]
  licenses      TechnoLicense[]

  @@index([status])
}

// Un produit TECHNOTCHAD (SIGEC-SM aujourd'hui, d'autres ERP demain — le
// meme moteur d'abonnement/licence doit servir tous les produits futurs).
model TechnoProduct {
  id          String   @id @default(cuid())
  productCode String   @unique
  name        String
  description String?
  version     String?
  productType String?
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE | DEVELOPMENT | DISCONTINUED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules       TechnoProductModule[]
  plans         TechnoSubscriptionPlan[]
  subscriptions TechnoSubscription[]
  contracts     TechnoContract[]
  licenses      TechnoLicense[]

  @@index([status])
}

// Referentiel des modules activables d'un produit (ex. CIVIL_STATUS,
// MARKETS... pour SIGEC-SM) — configurable, jamais code en dur dans
// l'application (meme regle que le referentiel d'activites economiques).
model TechnoProductModule {
  id          String  @id @default(cuid())
  productId   String
  moduleCode  String
  name        String
  description String?
  isActive    Boolean @default(true)

  product             TechnoProduct              @relation(fields: [productId], references: [id])
  subscriptionModules TechnoSubscriptionModule[]

  @@unique([productId, moduleCode])
}

model TechnoSubscriptionPlan {
  id              String   @id @default(cuid())
  productId       String
  planCode        String
  name            String
  description     String?
  billingPeriod   String // MONTHLY | QUARTERLY | SEMIANNUAL | ANNUAL | CUSTOM
  price           Float
  currency        String   @default("XAF")
  maxUsers        Int?
  maxSites        Int?
  maxModules      Int?
  setupFee        Float?   @default(0)
  gracePeriodDays Int      @default(0)
  autoRenew       Boolean  @default(false)
  status          String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product       TechnoProduct        @relation(fields: [productId], references: [id])
  subscriptions TechnoSubscription[]

  @@unique([productId, planCode])
}

// CTR-2026-000001
model TechnoContract {
  id             String    @id @default(cuid())
  contractNumber String    @unique
  clientId       String
  productId      String
  contractTitle  String
  startDate      DateTime
  endDate        DateTime?
  contractAmount Float?
  currency       String    @default("XAF")
  paymentTerms   String?
  renewalType    String? // AUTO | MANUAL | NONE
  status         String    @default("ACTIVE") // DRAFT | ACTIVE | EXPIRED | TERMINATED
  documentUrl    String?
  signedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client        TechnoClient         @relation(fields: [clientId], references: [id])
  product       TechnoProduct        @relation(fields: [productId], references: [id])
  subscriptions TechnoSubscription[]

  @@index([clientId])
  @@index([status])
}

// SUB-2026-000001. status: DRAFT | PENDING | ACTIVE | PAYMENT_DUE | OVERDUE |
// GRACE_PERIOD | SUSPENDED | EXPIRED | CANCELLED | TERMINATED.
model TechnoSubscription {
  id                 String    @id @default(cuid())
  subscriptionNumber String    @unique
  clientId           String
  productId          String
  planId             String
  contractId         String?
  startDate          DateTime
  endDate            DateTime
  nextBillingDate    DateTime?
  amount             Float
  currency           String    @default("XAF")
  status             String    @default("DRAFT")
  autoRenew          Boolean   @default(false)
  gracePeriodEnd     DateTime?
  suspendedAt        DateTime?
  terminatedAt       DateTime?
  terminationReason  String?
  createdById        String?
  updatedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  client   TechnoClient           @relation(fields: [clientId], references: [id])
  product  TechnoProduct          @relation(fields: [productId], references: [id])
  plan     TechnoSubscriptionPlan @relation(fields: [planId], references: [id])
  contract TechnoContract?        @relation(fields: [contractId], references: [id])

  licenses TechnoLicense[]
  modules  TechnoSubscriptionModule[]
  users    TechnoSubscriptionUser[]
  sites    TechnoSubscriptionSite[]
  renewals TechnoSubscriptionRenewal[]

  @@index([clientId])
  @@index([status])
}

model TechnoSubscriptionModule {
  subscriptionId String
  moduleId       String
  enabled        Boolean   @default(true)
  activationDate DateTime  @default(now())
  expirationDate DateTime?

  subscription TechnoSubscription  @relation(fields: [subscriptionId], references: [id])
  module       TechnoProductModule @relation(fields: [moduleId], references: [id])

  @@id([subscriptionId, moduleId])
}

// Utilisateurs SIGEC-SM (User) couverts par un abonnement — sert de base au
// controle "utilisateurs actifs <= max_users" (section 31), applique dans une
// phase suivante une fois cette table peuplee via l'interface TECHNOTCHAD.
model TechnoSubscriptionUser {
  id             String    @id @default(cuid())
  subscriptionId String
  userId         String
  assignedAt     DateTime  @default(now())
  revokedAt      DateTime?
  status         String    @default("ACTIVE") // ACTIVE | REVOKED

  subscription TechnoSubscription @relation(fields: [subscriptionId], references: [id])
  user         User               @relation(fields: [userId], references: [id])

  @@unique([subscriptionId, userId])
}

// Sites couverts par l'abonnement (pour SIGEC-SM : Mairie Centrale + les
// arrondissements). Champ libre (siteName) plutot qu'une FK vers
// Arrondissement : un futur produit TECHNOTCHAD n'aura pas d'arrondissements.
model TechnoSubscriptionSite {
  id             String   @id @default(cuid())
  subscriptionId String
  clientId       String
  siteName       String
  siteCode       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  subscription TechnoSubscription @relation(fields: [subscriptionId], references: [id])
  client       TechnoClient       @relation(fields: [clientId], references: [id])

  @@index([subscriptionId])
}

// Cle de licence generee par entropie aleatoire (voir generateLicenseKey()
// dans lib/ids.ts), jamais reutilisee. status: GENERATED | ACTIVE |
// SUSPENDED | EXPIRED | REVOKED. licenseType: TRIAL | STANDARD |
// PROFESSIONAL | ENTERPRISE | GOVERNMENT | CUSTOM.
model TechnoLicense {
  id               String    @id @default(cuid())
  licenseKey       String    @unique
  subscriptionId   String    @unique
  clientId         String
  productId        String
  licenseType      String
  issuedAt         DateTime  @default(now())
  activatedAt      DateTime?
  expiresAt        DateTime
  maxUsers         Int?
  maxSites         Int?
  status           String    @default("GENERATED")
  activationToken  String?   @unique
  lastValidationAt DateTime?
  suspendedAt      DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  subscription TechnoSubscription @relation(fields: [subscriptionId], references: [id])
  client       TechnoClient       @relation(fields: [clientId], references: [id])
  product      TechnoProduct      @relation(fields: [productId], references: [id])

  @@index([clientId])
  @@index([status])
}

// Historique des renouvellements (section 16) : jamais ecrase, une ligne par
// renouvellement reel.
model TechnoSubscriptionRenewal {
  id             String   @id @default(cuid())
  subscriptionId String
  oldEndDate     DateTime
  newStartDate   DateTime
  newEndDate     DateTime
  amount         Float?
  renewedById    String?
  renewedAt      DateTime @default(now())

  subscription TechnoSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
}
